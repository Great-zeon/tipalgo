# =====================================================================
# TIPALGO v21 — PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and configure values before starting the application.
# =====================================================================

# Server Networking
PORT=8000
HOST=0.0.0.0

# Application Environment & Debug Settings
ENVIRONMENT=production
DEBUG=False

# JWT Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_64_char_hex_secret_key
ADMIN_TOKEN=replace_with_a_secure_admin_token

# SQLite Database Location
# For local development: leave blank or set to ./tipalgo.db
# For Railway Persistent Volume: set to /data/tipalgo.db
DATABASE_PATH=
DATABASE_URL=

# Live Sports Data Ingestion (Live Football API / API-Sports)
FOOTBALL_API_KEY=your_live_football_api_key_here
FOOTBALL_API_BASE=https://live-football-api.com/api/v1

# Paystack Payment Gateway Integration
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key_here
PRO_PRICE=20000

# CORS Allowed Origins (Comma-separated for multiple domains)
ALLOWED_ORIGINS=https://tipalgo.com,https://www.tipalgo.com,http://localhost:8000

# Optional: Redis Cache (Leave blank for in-memory caching)
REDIS_URL=
